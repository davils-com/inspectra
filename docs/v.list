<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE vars SYSTEM "https://resources.jetbrains.com/writerside/1.0/vars.dtd">
<vars>
    <!-- Product identity -->
    <var name="product" value="Inspectra"/>
    <var name="package" value="inspectra"/>
    <var name="version" value="2.1.0"/>

    <!-- Compatibility. The single source of truth for every version stated in the
         documentation. min_dart is the SDK lower bound of pubspec.yaml, which CI tests
         next to the stable channel; tested_dart is the stable SDK tool/verify.dart last
         passed with locally; tested_trivy is TrivyConfig.pinnedVersion, the
         release Inspectra downloads by default and CI provisions; the others are the
         lower bounds of pubspec.yaml. -->
    <var name="min_dart" value="3.13.4"/>
    <var name="tested_dart" value="3.13.5"/>
    <var name="tested_trivy" value="0.75.0"/>
    <var name="min_build_runner" value="2.17.1"/>
    <var name="analyzer_version" value="14.4.0"/>
    <var name="build_version" value="5.0.0"/>
    <var name="coverage_version" value="1.15.1"/>

    <!-- Files and directories Inspectra reads or writes -->
    <var name="config_file" value="inspectra.yaml"/>
    <var name="pubspec_key" value="inspectra"/>
    <var name="secret_config" value="trivy-secret.yaml"/>
    <var name="report_dir" value=".dart_tool/inspectra/trivy"/>
    <var name="artifact_dir" value=".dart_tool/build/generated/&lt;package&gt;/inspectra/trivy"/>
    <var name="trivy_env" value="INSPECTRA_TRIVY"/>

    <!-- Links -->
    <var name="repo" value="https://github.com/davils-com/Inspectra"/>
    <var name="issues" value="https://github.com/davils-com/Inspectra/issues"/>
    <var name="trivy_docs" value="https://trivy.dev/latest/docs"/>
    <var name="trivy_install" value="https://trivy.dev/latest/getting-started/installation/"/>
</vars>
